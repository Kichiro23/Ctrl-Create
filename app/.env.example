# ============================================================
#  REQUIRED — App will crash in production if these are missing
# ============================================================

# Kimi OAuth (Authentication)
APP_ID=                    # Kimi OAuth App ID
APP_SECRET=                # Kimi OAuth App Secret (also used for JWT signing)
KIMI_AUTH_URL=             # Kimi OAuth server URL (e.g. https://kimi-auth-url.com)
KIMI_OPEN_URL=             # Kimi Open Platform API URL

# MongoDB Atlas (Database)
MONGODB_URI=               # Connection string: mongodb+srv://user:pass@cluster.mongodb.net/dbname

# ============================================================
#  REQUIRED FOR FRONTEND BUILD (Vite exposes these to browser)
# ============================================================

VITE_APP_URL=              # Your production domain (https://cylux-code.vercel.app)
VITE_KIMI_AUTH_URL=        # Same as KIMI_AUTH_URL
VITE_APP_ID=               # Same as APP_ID

# ============================================================
#  OPTIONAL — App works without these but features are degraded
# ============================================================

# Admin / Notifications
OWNER_UNION_ID=            # Your Kimi union ID — first login gets "admin" role
OWNER_EMAIL=               # Email to receive contact form submissions (default: rommeld216@gmail.com)

# AI Chatbot (OpenRouter)
OPENROUTER_API_KEY=        # OpenRouter API key for the chatbot
OPENROUTER_MODEL=          # Model ID (default: openai/gpt-4o-mini)

# Email (Resend)
RESEND_API_KEY=            # Resend API key for contact notifications
RESEND_FROM_EMAIL=         # Verified sender address (default: onboarding@resend.dev — test mode only!)

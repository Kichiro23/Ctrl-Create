# App
APP_ID=                   # Application ID (Kimi OAuth)
APP_SECRET=               # Application secret (Kimi OAuth JWT signing)
OWNER_UNION_ID=           # Union ID of the app creator; gets "admin" role on first login
OWNER_EMAIL=              # Email address to receive contact notifications

# OAuth
KIMI_AUTH_URL=            # Kimi OAuth server URL (backend)
KIMI_OPEN_URL=            # Kimi Open Platform URL

# Database (MongoDB Atlas)
MONGODB_URI=              # MongoDB connection string (mongodb+srv://user:pass@cluster.mongodb.net/dbname)

# AI (OpenRouter)
OPENROUTER_API_KEY=       # OpenRouter API key for chatbot
OPENROUTER_MODEL=         # Model ID (default: anthropic/claude-3.5-sonnet)

# Email (Resend)
RESEND_API_KEY=           # Resend API key for contact form notifications

# Frontend (exposed to browser via Vite)
VITE_APP_URL=             # Production domain (e.g. https://cylux-code.vercel.app)
VITE_KIMI_AUTH_URL=       # Kimi OAuth server URL (frontend)
VITE_APP_ID=              # OAuth application ID (frontend)
